```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj

# Dependencies
.venv/
venv/
node_modules/

# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Coverage and testing
.coverage
coverage/
htmlcov/

# Distribution and build
dist/
build/
target/
*.egg-info/

# Python specific
*.pyo
*.pyd
.Python
*.so

# System files
.DS_Store
Thumbs.db
```